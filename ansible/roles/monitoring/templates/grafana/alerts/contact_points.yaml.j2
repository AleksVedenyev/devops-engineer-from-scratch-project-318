apiVersion: 1

contactPoints:
  - name: Email
    receivers:
      - uid: email-notifier
        type: email
        settings:
          addresses: "{{ monitoring_grafana_alert_email }}"

policies:
  - orgId: 1
    receiver: Email
    group_by: ['alertname', 'cluster', 'service']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h