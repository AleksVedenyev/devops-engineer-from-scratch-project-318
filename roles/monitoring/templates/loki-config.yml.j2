auth_enabled: false
server:
  http_listen_port: {{ monitoring_loki_port }}
  grpc_listen_port: {{ monitoring_loki_grpc_port }}
  log_level: info
common:
  path_prefix: {{ monitoring_loki_data_directory }}
  storage:
    {{ monitoring_loki_config_storage_type }}:
      chunks_directory: {{ monitoring_loki_data_directory }}/chunks
      rules_directory: {{ monitoring_loki_data_directory }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: "{{ monitoring_loki_config_date }}"
      store: tsdb
      object_store: {{ monitoring_loki_config_storage_type }}
      schema: v13
      index:
        prefix: index_
        period: 24h
storage_config:
  tsdb_shipper:
    active_index_directory: {{ monitoring_loki_data_directory }}/tsdb-index
    cache_location: {{ monitoring_loki_data_directory }}/tsdb-cache
    cache_ttl: 24h
  filesystem:
    directory: {{ monitoring_loki_data_directory }}/chunks
limits_config:
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  retention_period: 720h
  max_query_lookback: 720h
compactor:
  working_directory: {{ monitoring_loki_data_directory }}/compactor
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 150
  delete_request_store: filesystem
query_range:
  align_queries_with_step: true