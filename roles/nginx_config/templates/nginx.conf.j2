# Формат для access-лога в конексте http
{{ nginx_config_json_combined_log_format }} 

server {
    listen {{ nginx_config_server_port }};
    access_log {{nginx_config_access_log_path}} {{ nginx_config_log_format_server_block }};
    server_name {{ nginx_config_app_domain }} www.{{ nginx_config_app_domain }};

    location /.well-known/acme-challenge/ {
        root {{ app_rootdir }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}       

server {
    listen {{ nginx_config_https_server_port }} ssl http2;
    access_log {{nginx_config_access_log_path}} {{ nginx_config_log_format_server_block }};
    server_name {{ nginx_config_app_domain }} www.{{ nginx_config_app_domain }};

    ssl_certificate     {{ nginx_config_ssl_certificate }};
    ssl_certificate_key {{ nginx_config_ssl_certificate_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://{{ nginx_config_app_loopback_host }}:{{ nginx_config_app_loopback_port }};
        include proxy_params;
    }

    location /actuator/ {
        deny all;
    }

    location /actuator/health {
        proxy_pass http://{{ nginx_config_app_loopback_host }}:{{ nginx_config_app_management_server_port }};
        access_log off;
        include proxy_params;
    }

    location /actuator/prometheus {
        auth_basic "Metrics";
        auth_basic_user_file {{ nginx_config_auth_basic_user_file_path }};
        proxy_pass http://{{ nginx_config_app_loopback_host }}:{{ nginx_config_app_management_server_port }};
        access_log off;
        include proxy_params;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|webp|woff|woff2|ttf)$ {
        proxy_pass http://{{ nginx_config_app_loopback_host }}:{{ nginx_config_app_loopback_port }};
        include proxy_params;
        expires 3d;
        add_header Cache-Control "public, no-transform";
    }
}